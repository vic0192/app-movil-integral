# Copy this file to .env for local development. Never commit .env or real secrets.
PORT=3000

# Render PostgreSQL: use its Internal Database URL when the API is in the same region.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a random value of at least 32 bytes. Keep it private.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Paste the complete Firebase service-account JSON as a single-line JSON value.
# Grant the service account only the Firestore access the API needs.
FIREBASE_SERVICE_ACCOUNT_JSON=

# The Render blueprint configures this to false for its managed database.
PGSSL=false
